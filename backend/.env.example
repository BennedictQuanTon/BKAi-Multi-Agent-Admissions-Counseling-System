# ===== LLM (Google Gemini) =====
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# comma-separated failover pool — each model has its own per-minute quota
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite
GEMINI_RPM_PER_MODEL=14

# ===== Redis (sessions · telemetry · rate limit) =====
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=bkai

# ===== Qdrant — empty URL = embedded local mode (data/build/qdrant) =====
QDRANT_URL=
QDRANT_API_KEY=

# ===== Retrieval models (chosen by evaluation/run_retrieval_bench.py) =====
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
EMBEDDING_DEVICE=auto
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MAX_LENGTH=384
SEARCH_RERANK_CANDIDATES=12
SEARCH_TOP_K=6

# ===== Semantic cache (entity-guarded, owner-approved answers only) =====
CACHE_ENABLED=true
CACHE_THRESHOLD=0.90

# ===== API / security =====
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
APP_ENV=development                # production → docs off, HSTS, admin token mandatory, WS Origin required
RATE_LIMIT_PER_MINUTE=30           # per client IP
RATE_LIMIT_PER_DAY=400             # per client IP — bounds LLM spend
MAX_WS_PER_IP=6
MAX_BODY_BYTES=64000
VOICE_MAX_SESSION_S=600            # AssemblyAI bills per streamed second
TRUSTED_PROXIES=                   # e.g. caddy — only these may set X-Forwarded-For
MAX_INPUT_LENGTH=500
ADMIN_TOKEN=                       # required in production (python -c "import secrets;print(secrets.token_urlsafe(32))")
GUARDRAILS_ENABLED=true

# ===== Voice =====
VOICE_TTS_PROVIDER=kokoro          # kokoro | edge | gemini
VOICE_KOKORO_VOICE=mai_linh
ASSEMBLYAI_API_KEY=                # set to enable AssemblyAI Universal-3.6 Pro streaming STT
# LiveKit realtime worker (optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
